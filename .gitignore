# Raw upstream pull - 62 MB, reproducible via ./fetch_data.sh
data/raw/

# Secrets
.env
.env.local

# Python
__pycache__/
*.pyc
.ipynb_checkpoints/

# Tableau working files
*.twb.bak
*.hyper
dashboard/__pycache__/

# Generated agent/editor tooling — PUBLIC repo, so these are ignored here. Scoped to the
# generated paths, not whole directories, so deliberate project config such as
# .claude/settings.json stays committable. Streamlit 1.62+ symlinks .agents/skills/ and
# .claude/skills/ into any project it runs from, pointing into the local conda env;
# link-cursor.sh writes the .cursor/ entries. All are machine-specific and broken for
# anyone cloning. There is no global gitignore on this machine, so it is handled here.
.cursor/skills/
.cursor/rules/agent-skills-conventions.mdc
.claude/skills/
.agents/skills/

# macOS
.DS_Store

# Local Streamlit config — machine-specific, and credentials.toml carries an email stamp
.streamlit/

# Office lock files (a deck open in PowerPoint leaves one behind)
~$*

# Operator working state — one machine's decisions, not part of the deliverable
mvp/queues/decision_events.json
# Intermediates only. The finished recordings are COMMITTED — deliverable 2
# requires the POC demo as a file, so ignoring them would hide a deliverable.
demo/build/
demo/.browser-profile/
mvp/queues/settings.json

# regenerated by presentation/assets/render_slide.py; the deck already carries it
presentation/assets/decision_spine_slide.png
